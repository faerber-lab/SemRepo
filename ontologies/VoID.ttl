    a foaf:Person ;
    foaf:name "Abdul Rafay" ;
    rdfs:label "Abdul Rafay" ;
    foaf:mbox <mailto:abdul.rafay@mailbox.tu-dresden.de> .

:Yuni_Susanti
    a foaf:Person ;
    foaf:name "Yuni Susanti" ;
    rdfs:label "Yuni Susanti" .

:David_Lamprecht
