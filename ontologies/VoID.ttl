@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <#> .

:SemRepo
    a void:Dataset ;
    foaf:homepage <https://semrepo.org> ;
    dcterms:title "SemRepo"@en ;
    dcterms:description "SemRepo is an RDF knowledge graph of GitHub repositories linked to scientific research, integrating repository metadata with scholarly knowledge graphs for large-scale analysis of software within the broader scientific research ecosystem."@en ;
    
    void:sparqlEndpoint <https://semrepo.org/sparql> ;

    dcterms:creator :Michael_Faerber ;
    dcterms:creator :Abdul_Rafay ;
	dcterms:creator :Yuni_Susanti ;
    dcterms:creator :David_Lamprecht ;

    dcterms:publisher :ScadsAI_TUDresden ;

    dcterms:source <https://github.com/faerber-lab/SemRepo> ;

    dcterms:modified "2026-04-29"^^xsd:date ;

    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;

    dcterms:subject <http://dbpedia.org/resource/Computer_science> ;
    dcterms:subject <http://dbpedia.org/resource/Knowledge_graph> ;
    dcterms:subject <http://dbpedia.org/resource/Resource_Description_Framework> ;

	void:feature <http://www.w3.org/ns/formats/Turtle> ;
	void:feature <http://www.w3.org/ns/formats/N-Triples> ;

    void:triples "81485930"^^xsd:integer ;

    void:vocabulary <http://xmlns.com/foaf/0.1/> ;
    void:vocabulary <http://www.w3.org/2001/XMLSchema#> ;
    void:vocabulary <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ;
    void:vocabulary <http://www.w3.org/2000/01/rdf-schema#> ;
    void:vocabulary <http://purl.org/dc/terms/> ;
    void:vocabulary <http://purl.org/spar/fabio/> ;
    void:vocabulary <https://linkedpaperswithcode.com/ontology#> ;
    void:vocabulary <https://semopenalex.org/ontology#> ;
    void:vocabulary <https://w3id.org/mlsea/pwc/> ;
    void:vocabulary <http://www.w3.org/2002/07/owl#> ;

    void:linkPredicate dcterms:creator .

:ScadsAI_TUDresden
    a foaf:Organization ;
    foaf:name "ScaDS.AI, TU Dresden" ;
    foaf:homepage <https://scads.ai/> .

:Michael_Faerber
    a foaf:Person ;
    foaf:name "Michael Färber" ;
    rdfs:label "Michael Färber" ;
    foaf:homepage <https://faerber-lab.github.io/> ;
    foaf:mbox <mailto:michael.faerber@tu-dresden.de> .

