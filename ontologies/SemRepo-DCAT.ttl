@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://semrepo.org/dataset/semrepo>
    a dcat:Dataset ;
    dcterms:title "SemRepo"@en ;
    dcterms:description "SemRepo is an RDF knowledge graph of GitHub repositories linked to scientific research, integrating repository metadata with scholarly knowledge graphs for large-scale analysis of software within the broader scientific research ecosystem."@en ;
    dcterms:creator [
        a foaf:Person ;
        foaf:name "Michael Färber"
    ] ,
    [
        a foaf:Person ;
        foaf:name "Abdul Rafay"
    ] ,
   [
        a foaf:Person ;
        foaf:name "Yuni Susanti"
    ] ,
    [
        a foaf:Person ;
        foaf:name "David Lamprecht"
    ] ;
 
    dcterms:publisher [
        a foaf:Organization ;
        foaf:name "ScaDS.AI, TU Dresden"
    ] ;
    dcterms:issued "2025-05-13"^^xsd:date ;
    dcterms:modified "2026-04-29"^^xsd:date ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.15399467> ;
    dcat:keyword
        "software repository",
        "research software",
        "knowledge graph",
        "RDF",
        "GitHub repositories",
        "scholarly metadata",
        "research reproducibility" ;
    dcat:landingPage <https://semrepo.org> ;
    dcat:contactPoint [
        a vcard:Kind ;
        vcard:fn "Michael Färber" ;
        vcard:hasEmail <mailto:michael.faerber@tu-dresden.de>
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dcterms:title "SemRepo RDF Dump v1 (Turtle)"@en ;
        dcterms:issued "2025-05-13"^^xsd:date ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
        dcat:downloadURL <https://doi.org/10.5281/zenodo.15399468> ;
        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        owl:versionInfo "v1"
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dcterms:title "SemRepo RDF Dump v1 (N-Triples)"@en ;
        dcterms:issued "2025-05-13"^^xsd:date ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/application/n-triples> ;
        dcat:downloadURL <https://doi.org/10.5281/zenodo.15399468> ;
        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        owl:versionInfo "v1"
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dcterms:title "SemRepo RDF Dump v2 (Turtle)"@en ;
        dcterms:issued "2026-04-29"^^xsd:date ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
        dcat:downloadURL <https://doi.org/10.5281/zenodo.20084784> ;
        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        owl:versionInfo "v2"
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dcterms:title "SemRepo RDF Dump v2 (N-Triples)"@en ;
        dcterms:issued "2026-04-29"^^xsd:date ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/application/n-triples> ;
        dcat:downloadURL <https://doi.org/10.5281/zenodo.20084784> ;
        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        owl:versionInfo "v2"
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
        dcterms:title "SPARQL Endpoint"@en ;
        dcat:accessURL <https://semrepo.org/sparql>
    ] ;
    dcat:distribution [
        a dcat:Distribution ;
