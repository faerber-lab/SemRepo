@prefix : <https://semrepo.org/ontology/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://semrepo.org/ontology/v2#> .

@prefix dcterms: <http://purl.org/dc/terms/> .

<https://semrepo.org/ontology/v2#> rdf:type owl:Ontology ;
    dcterms:title "SemRepo Ontology"@en ;
    dcterms:description "Ontology for the SemRepo knowledge graph: GitHub repositories, their dated snapshots, accounts, contributions, languages, licenses, topics, issues/pull requests, and evidence-based links to scholarly knowledge graphs."@en ;
    owl:versionInfo "2.1.0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-20" ;
    rdfs:label "SemRepo Ontology v2.1"@en .

#################################################################
#    Object Properties
#################################################################

###  https://semrepo.org/ontology/v2#belongsToRepository
:belongsToRepository rdf:type owl:ObjectProperty ;
                     owl:inverseOf :hasIssue ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :Issue ;
                     rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#collectionStatus
:collectionStatus rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CollectionActivity ;
                  rdfs:range :CollectionStatus .


###  https://semrepo.org/ontology/v2#contributionToSnapshot
:contributionToSnapshot rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Contribution ;
                        rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#contributor
:contributor rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Contribution ;
             rdfs:range :GitHubAccount .


###  https://semrepo.org/ontology/v2#hasExternalLink
:hasExternalLink rdf:type owl:ObjectProperty ;
                 owl:inverseOf :linkSource ;
                 rdfs:range :ExternalLink .


###  https://semrepo.org/ontology/v2#hasIssue
:hasIssue rdf:type owl:ObjectProperty ;
          rdfs:domain :Repository ;
          rdfs:range :Issue .


###  https://semrepo.org/ontology/v2#hasSnapshot
:hasSnapshot rdf:type owl:ObjectProperty ;
             owl:inverseOf :snapshotOf ;
             rdfs:domain :Repository ;
             rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#languageUsageIn
:languageUsageIn rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :LanguageUsage ;
                 rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#linkSource
:linkSource rdf:type owl:ObjectProperty ;
            rdfs:domain :ExternalLink .


###  https://semrepo.org/ontology/v2#programmingLanguage
:programmingLanguage rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :LanguageUsage ;
                     rdfs:range :ProgrammingLanguage .


###  https://semrepo.org/ontology/v2#resolutionStatus
:resolutionStatus rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range :ResolutionStatus .


###  https://semrepo.org/ontology/v2#resolvedRepository
:resolvedRepository rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :SourceRepositoryLink ;
                    rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#resultedInRepository
:resultedInRepository rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :CollectionActivity ;
                      rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#snapshotOf
:snapshotOf rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range :Repository .


#################################################################
#    Data properties
#################################################################

###  https://semrepo.org/ontology/v2#archived
:archived rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :RepositorySnapshot ;
          rdfs:range xsd:boolean .


###  https://semrepo.org/ontology/v2#attemptedUrl
:attemptedUrl rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :CollectionActivity ;
              rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#canonicalUrl
:canonicalUrl rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Repository ;
              rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#collectedAt
:collectedAt rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#collectionSource
:collectionSource rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CollectionActivity ;
                  rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#collectionTimestamp
:collectionTimestamp rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :CollectionActivity ;
                     rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#commitCount
:commitCount rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Contribution ;
             rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#confidenceScore
:confidenceScore rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ExternalLink ;
                 rdfs:range xsd:decimal .


###  https://semrepo.org/ontology/v2#createdAt
:createdAt rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Repository ;
           rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#description
:description rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#finalResolvedUrl
:finalResolvedUrl rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#forksCount
:forksCount rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubIssueId
:githubIssueId rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Issue ;
               rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubLogin
:githubLogin rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :GitHubAccount ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#githubRepositoryId
:githubRepositoryId rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Repository ;
                    rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubUserId
:githubUserId rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :GitHubAccount ;
              rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#issueClosedAt
:issueClosedAt rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Issue ;
               rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#issueCreatedAt
:issueCreatedAt rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Issue ;
                rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#issueNumber
:issueNumber rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Issue ;
             rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#issueState
:issueState rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Issue ;
            rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#languageBytes
:languageBytes rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :LanguageUsage ;
               rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#languageName
:languageName rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ProgrammingLanguage ;
              rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkDecision
:linkDecision rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ExternalLink ;
              rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkRelationType
:linkRelationType rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :ExternalLink ;
                  rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkTarget
:linkTarget rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :ExternalLink ;
            rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#linkingMethod
:linkingMethod rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ExternalLink ;
               rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#openIssuesCount
:openIssuesCount rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :RepositorySnapshot ;
                 rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#originalRepositoryUrl
:originalRepositoryUrl rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :SourceRepositoryLink ;
                       rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#profileUrl
:profileUrl rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :GitHubAccount ;
            rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#starsCount
:starsCount rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#targetKnowledgeGraph
:targetKnowledgeGraph rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :ExternalLink ;
                      rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://semrepo.org/ontology/v2#CollectionActivity
:CollectionActivity rdf:type owl:Class ;
                    rdfs:comment "A single attempt by the data collection pipeline to fetch or resolve data for a target URL, whether or not it succeeded. Supports provenance and completeness tracking."@en ;
                    rdfs:label "Collection Activity"@en .


###  https://semrepo.org/ontology/v2#CollectionStatus
:CollectionStatus rdf:type owl:Class ;
                  rdfs:comment "A controlled set of possible outcomes for a single collection attempt, distinct from ResolutionStatus which tracks LPWC URL-to-Repository resolution specifically."@en ;
                  rdfs:label "Collection Status"@en .


###  https://semrepo.org/ontology/v2#Contribution
:Contribution rdf:type owl:Class ;
              rdfs:comment "Represents a GitHub account's commit contribution to a specific repository snapshot, replacing v1's duplicated ContributorReference/hasContributorReference classes."@en ;
              rdfs:label "Contribution"@en .


###  https://semrepo.org/ontology/v2#ExternalLink
:ExternalLink rdf:type owl:Class ;
              rdfs:comment "A qualified, evidence-based link from a SemRepo entity to an entity in an external knowledge graph (e.g. SemOpenAlex, LPWC, MLSea-KG), carrying provenance and confidence information rather than asserting direct identity."@en ;
              rdfs:label "External Link"@en .


###  https://semrepo.org/ontology/v2#GitHubAccount
:GitHubAccount rdf:type owl:Class ;
               rdfs:comment "A GitHub account, which may represent a human user, an organisation, or a bot. Not necessarily a natural person."@en ;
               rdfs:label "GitHub Account"@en .


###  https://semrepo.org/ontology/v2#GitHubBot
:GitHubBot rdf:type owl:Class ;
           rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubOrganisation
:GitHubOrganisation rdf:type owl:Class ;
                    rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubUser
:GitHubUser rdf:type owl:Class ;
            rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#Issue
:Issue rdf:type owl:Class ;
       rdfs:comment "A GitHub issue belonging to a repository. GitHub's issues API returns issues and pull requests together; both are represented by this class, and PullRequest is the subtype for pull requests."@en ;
       rdfs:label "Issue"@en .


###  https://semrepo.org/ontology/v2#LanguageUsage
:LanguageUsage rdf:type owl:Class ;
               rdfs:comment "Represents the usage of a programming language within a specific repository snapshot, replacing v1's duplicated LanguageReference/GitHubRepositoryLanguageReference classes."@en ;
               rdfs:label "Language Usage"@en .


###  https://semrepo.org/ontology/v2#ProgrammingLanguage
:ProgrammingLanguage rdf:type owl:Class ;
                     rdfs:comment "A programming language (e.g. Python, C++), identified by name."@en ;
                     rdfs:label "Programming Language"@en .


###  https://semrepo.org/ontology/v2#PullRequest
:PullRequest rdf:type owl:Class ;
             rdfs:subClassOf :Issue ;
             rdfs:comment "A GitHub pull request. Modeled as a subclass of Issue since PRs share most Issue fields but add PR-specific semantics."@en ;
             rdfs:label "Pull Request"@en .


###  https://semrepo.org/ontology/v2#Repository
:Repository rdf:type owl:Class ;
            rdfs:comment "A GitHub repository, identified by its stable numeric GitHub ID. Represents only identity-level information; mutable metadata is captured in RepositorySnapshot instances."@en ;
            rdfs:label "Repository"@en .


###  https://semrepo.org/ontology/v2#RepositorySnapshot
:RepositorySnapshot rdf:type owl:Class ;
                    rdfs:comment "A dated observation of a Repository's mutable metadata (stars, forks, issues, description, etc.) at a specific collection time."@en ;
                    rdfs:label "Repository Snapshot"@en .


###  https://semrepo.org/ontology/v2#ResolutionStatus
:ResolutionStatus rdf:type owl:Class ;
                  rdfs:comment "A controlled set of possible outcomes for resolving a source repository URL to a canonical Repository."@en ;
                  rdfs:label "Resolution Status"@en .


###  https://semrepo.org/ontology/v2#SourceRepositoryLink
:SourceRepositoryLink rdf:type owl:Class ;
                      rdfs:comment "Represents the resolution process from an originally recorded LPWC repository URL to a canonical Repository, tracking redirects, renames, or failures."@en ;
                      rdfs:label "Source Repository Link"@en .


#################################################################
#    Individuals
#################################################################

###  https://semrepo.org/ontology/v2#ApiError
:ApiError rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Deleted
:Deleted rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Failed
:Failed rdf:type owl:NamedIndividual ,
                 :CollectionStatus .


###  https://semrepo.org/ontology/v2#Forbidden
:Forbidden rdf:type owl:NamedIndividual ,
                    :CollectionStatus .


###  https://semrepo.org/ontology/v2#Invalid
:Invalid rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#NotFound
:NotFound rdf:type owl:NamedIndividual ,
                   :CollectionStatus .


###  https://semrepo.org/ontology/v2#PartialSuccess
:PartialSuccess rdf:type owl:NamedIndividual ,
                         :CollectionStatus .


###  https://semrepo.org/ontology/v2#Private
:Private rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#RateLimited
:RateLimited rdf:type owl:NamedIndividual ,
                      :CollectionStatus .


###  https://semrepo.org/ontology/v2#Renamed
:Renamed rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Resolved
:Resolved rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Success
:Success rdf:type owl:NamedIndividual ,
                  :CollectionStatus .


###  https://semrepo.org/ontology/v2#Transferred
:Transferred rdf:type owl:NamedIndividual ,
                      :ResolutionStatus .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :GitHubBot
                :GitHubOrganisation
                :GitHubUser
              )
] .



#################################################################
#    v2.1 additions: new classes
#################################################################

:License rdf:type owl:Class ;
    rdfs:label "License"@en ;
    rdfs:comment "A software license under which a repository is released. Instances are identified by SPDX identifier IRIs (https://spdx.org/licenses/<id>)."@en .

:Topic rdf:type owl:Class ;
    rdfs:label "Topic"@en ;
    rdfs:comment "A GitHub topic (tag) assigned to a repository by its maintainers, e.g. 'machine-learning'."@en .

#################################################################
#    v2.1 additions: new object properties
#################################################################

:hasLicense rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ;
    rdfs:range :License ;
    rdfs:label "has license"@en ;
    rdfs:comment "The license GitHub detected for the repository at snapshot time."@en .

:hasTopic rdf:type owl:ObjectProperty ;
    rdfs:domain :RepositorySnapshot ;
    rdfs:range :Topic ;
    rdfs:label "has topic"@en ;
    rdfs:comment "A GitHub topic assigned to the repository at snapshot time."@en .

:primaryLanguage rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ;
    rdfs:range :ProgrammingLanguage ;
    rdfs:label "primary language"@en ;
    rdfs:comment "The main programming language reported by GitHub for the repository (the 'language' field)."@en .

:ownerAccount rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ;
    rdfs:range :GitHubAccount ;
    rdfs:label "owner account"@en ;
    rdfs:comment "The GitHub account owning the repository at snapshot time. Stored on the snapshot because ownership can change by transfer."@en .

:snapshotCollectedBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ;
    rdfs:range :CollectionActivity ;
    rdfs:label "snapshot collected by"@en ;
    rdfs:comment "The collection activity that produced this snapshot (provenance)."@en .

:issueAuthor rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Issue ;
    rdfs:range :GitHubAccount ;
    rdfs:label "issue author"@en ;
    rdfs:comment "The GitHub account that opened the issue or pull request."@en .

#################################################################
#    v2.1 additions: new data properties
#################################################################

# --- Repository: temporal ---
:pushedAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:dateTime ;
    rdfs:label "pushed at"@en ;
    rdfs:comment "Time of the most recent push to any branch (GitHub 'pushed_at'); the best API-level proxy for code activity."@en .

:updatedAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:dateTime ;
    rdfs:label "updated at"@en ;
    rdfs:comment "Time of the last update of the repository record (GitHub 'updated_at'); also changes on non-code events such as stars or settings changes."@en .

:lastCommitAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:dateTime ;
    rdfs:label "last commit at"@en ;
    rdfs:comment "Timestamp of the latest commit on the default branch (requires one extra API call per repository)."@en .

# --- Repository: descriptive ---
:repositoryName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:string ;
    rdfs:label "repository name"@en ;
    rdfs:comment "Short repository name (without owner) at snapshot time. Stored on the snapshot because repositories can be renamed."@en .

:fullName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:string ;
    rdfs:label "full name"@en ;
    rdfs:comment "Owner/name string (GitHub 'full_name') at snapshot time."@en .

:defaultBranch rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:string ;
    rdfs:label "default branch"@en ;
    rdfs:comment "Name of the repository's default branch."@en .

:homepageUrl rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:anyURI ;
    rdfs:label "homepage URL"@en ;
    rdfs:comment "Homepage URL set by the maintainers, if any."@en .

:isFork rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:boolean ;
    rdfs:label "is fork"@en ;
    rdfs:comment "Whether the repository is a fork of another repository."@en .

# --- Repository: counters ---
:watchersCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:integer ;
    rdfs:label "watchers count"@en ;
    rdfs:comment "Number of watchers (GitHub 'subscribers_count'). Not GitHub's 'watchers_count', which equals the star count."@en .

:contributorsCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:integer ;
    rdfs:label "contributors count"@en ;
    rdfs:comment "Total number of contributors, independent of how many Contribution records were collected."@en .

:issuesTotalCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:integer ;
    rdfs:label "issues total count"@en ;
    rdfs:comment "Total number of issues (open and closed, excluding pull requests) at snapshot time."@en .

:sizeKb rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RepositorySnapshot ; rdfs:range xsd:integer ;
    rdfs:label "size (KB)"@en ;
    rdfs:comment "Repository size in kilobytes as reported by GitHub."@en .

# --- License / Topic ---
:spdxId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :License ; rdfs:range xsd:string ;
    rdfs:label "SPDX identifier"@en ;
    rdfs:comment "SPDX license identifier, e.g. 'MIT' or 'Apache-2.0'. GitHub reports 'NOASSERTION' when no known license is detected."@en .

:licenseName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :License ; rdfs:range xsd:string ;
    rdfs:label "license name"@en ;
    rdfs:comment "Human-readable license name."@en .

:topicName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Topic ; rdfs:range xsd:string ;
    rdfs:label "topic name"@en ;
    rdfs:comment "The topic string exactly as used on GitHub (lowercase, hyphenated)."@en .

# --- GitHubAccount profile ---
:accountName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:string ;
    rdfs:label "account name"@en ;
    rdfs:comment "Display name of the account (user's name or organisation's name)."@en .

:accountDescription rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:string ;
    rdfs:label "account description"@en ;
    rdfs:comment "Profile bio (users) or description (organisations)."@en .

:accountLocation rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:string ;
    rdfs:label "account location"@en ;
    rdfs:comment "Free-text location from the public profile."@en .

:accountBlogUrl rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:anyURI ;
    rdfs:label "account blog URL"@en ;
    rdfs:comment "Website or blog URL from the public profile."@en .

:accountCreatedAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:dateTime ;
    rdfs:label "account created at"@en ;
    rdfs:comment "Time the GitHub account was created."@en .

:followersCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:integer ;
    rdfs:label "followers count"@en ;
    rdfs:comment "Number of followers at collection time."@en .

:publicReposCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GitHubAccount ; rdfs:range xsd:integer ;
    rdfs:label "public repositories count"@en ;
    rdfs:comment "Number of public repositories owned by the account at collection time."@en .

# --- Issue / PR extras ---
:issueTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Issue ; rdfs:range xsd:string ;
    rdfs:label "issue title"@en ; rdfs:comment "Title of the issue or pull request."@en .

:issueUrl rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Issue ; rdfs:range xsd:anyURI ;
    rdfs:label "issue URL"@en ; rdfs:comment "Web URL (html_url) of the issue or pull request."@en .

:issueUpdatedAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Issue ; rdfs:range xsd:dateTime ;
    rdfs:label "issue updated at"@en ; rdfs:comment "Time of the last update of the issue or pull request."@en .

:issueCommentCount rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Issue ; rdfs:range xsd:integer ;
    rdfs:label "issue comment count"@en ; rdfs:comment "Number of comments on the issue or pull request."@en .

:issueLabel rdf:type owl:DatatypeProperty ;
    rdfs:domain :Issue ; rdfs:range xsd:string ;
    rdfs:label "issue label"@en ; rdfs:comment "Name of a label attached to the issue or pull request (may occur several times)."@en .

:pullRequestMergedAt rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :PullRequest ; rdfs:range xsd:dateTime ;
    rdfs:label "pull request merged at"@en ; rdfs:comment "Time the pull request was merged; absent if not merged."@en .

#################################################################
#    v2.1 additions: labels and comments for existing terms
#################################################################

:GitHubUser rdfs:label "GitHub User"@en ; rdfs:comment "A GitHub account of type User (typically a human)."@en .
:GitHubOrganisation rdfs:label "GitHub Organisation"@en ; rdfs:comment "A GitHub account of type Organization."@en .
:GitHubBot rdfs:label "GitHub Bot"@en ; rdfs:comment "A GitHub account of type Bot (automated account)."@en .

:belongsToRepository rdfs:label "belongs to repository"@en ; rdfs:comment "Links an issue or pull request to the repository it belongs to."@en .
:hasIssue rdfs:label "has issue"@en ; rdfs:comment "Inverse of belongsToRepository."@en .
:collectionStatus rdfs:label "collection status"@en ; rdfs:comment "Outcome of a collection activity."@en .
:contributionToSnapshot rdfs:label "contribution to snapshot"@en ; rdfs:comment "The repository snapshot a contribution record belongs to."@en .
:contributor rdfs:label "contributor"@en ; rdfs:comment "The GitHub account that made the contribution."@en .
:hasExternalLink rdfs:label "has external link"@en ; rdfs:comment "Links a SemRepo entity to a qualified ExternalLink. Inverse of linkSource; deliberately has no domain so repositories and accounts can both be linked."@en .
:linkSource rdfs:label "link source"@en ; rdfs:comment "The SemRepo entity (repository or account) from which an ExternalLink originates."@en .
:hasSnapshot rdfs:label "has snapshot"@en ; rdfs:comment "Links a repository to one of its dated snapshots."@en .
:snapshotOf rdfs:label "snapshot of"@en ; rdfs:comment "Inverse of hasSnapshot."@en .
:languageUsageIn rdfs:label "language usage in"@en ; rdfs:comment "The repository snapshot a language usage record belongs to."@en .
:programmingLanguage rdfs:label "programming language"@en ; rdfs:comment "The language a LanguageUsage record refers to."@en .
:resolutionStatus rdfs:label "resolution status"@en ; rdfs:comment "Outcome of resolving the original URL."@en .
:resolvedRepository rdfs:label "resolved repository"@en ; rdfs:comment "The canonical repository a URL was resolved to."@en .
:resultedInRepository rdfs:label "resulted in repository"@en ; rdfs:comment "The repository a successful collection activity produced."@en .

:archived rdfs:label "archived"@en ; rdfs:comment "Whether the repository is archived (read-only) on GitHub."@en .
:attemptedUrl rdfs:label "attempted URL"@en ; rdfs:comment "The URL the pipeline tried to collect."@en .
:canonicalUrl rdfs:label "canonical URL"@en ; rdfs:comment "Canonical https://github.com/owner/name URL of the repository."@en .
:collectedAt rdfs:label "collected at"@en ; rdfs:comment "Time the snapshot was collected from the GitHub API."@en .
:collectionSource rdfs:label "collection source"@en ; rdfs:comment "The API endpoint or source used for the collection attempt."@en .
:collectionTimestamp rdfs:label "collection timestamp"@en ; rdfs:comment "Time of the collection attempt."@en .
:commitCount rdfs:label "commit count"@en ; rdfs:comment "Number of commits by the contributor in the repository."@en .
:confidenceScore rdfs:label "confidence score"@en ; rdfs:comment "Confidence (0..1) assigned to the link by the linking method."@en .
:createdAt rdfs:label "created at"@en ; rdfs:comment "Time the repository was created on GitHub."@en .
:description rdfs:label "description"@en ; rdfs:comment "Repository description text."@en .
:finalResolvedUrl rdfs:label "final resolved URL"@en ; rdfs:comment "The URL after following redirects."@en .
:forksCount rdfs:label "forks count"@en ; rdfs:comment "Number of forks at snapshot time."@en .
:githubIssueId rdfs:label "GitHub issue id"@en ; rdfs:comment "Stable numeric GitHub id of the issue or pull request."@en .
:githubLogin rdfs:label "GitHub login"@en ; rdfs:comment "Login (handle) of the account at collection time."@en .
:githubRepositoryId rdfs:label "GitHub repository id"@en ; rdfs:comment "Stable numeric GitHub id of the repository; survives renames and transfers."@en .
:githubUserId rdfs:label "GitHub account id"@en ; rdfs:comment "Stable numeric GitHub id of the account."@en .
:issueClosedAt rdfs:label "issue closed at"@en ; rdfs:comment "Time the issue or pull request was closed."@en .
:issueCreatedAt rdfs:label "issue created at"@en ; rdfs:comment "Time the issue or pull request was created."@en .
:issueNumber rdfs:label "issue number"@en ; rdfs:comment "Per-repository issue number."@en .
:issueState rdfs:label "issue state"@en ; rdfs:comment "State of the issue: 'open' or 'closed'."@en .
:languageBytes rdfs:label "language bytes"@en ; rdfs:comment "Bytes of code written in the language in the snapshot."@en .
:languageName rdfs:label "language name"@en ; rdfs:comment "Name of the programming language."@en .
:linkDecision rdfs:label "link decision"@en ; rdfs:comment "Decision on the link, e.g. accepted, rejected or needs review."@en .
:linkRelationType rdfs:label "link relation type"@en ; rdfs:comment "Semantic relation between source and target, e.g. 'implements' or 'described in'."@en .
:linkTarget rdfs:label "link target"@en ; rdfs:comment "IRI of the entity in the external knowledge graph."@en .
:linkingMethod rdfs:label "linking method"@en ; rdfs:comment "Method that produced the link, e.g. 'lpwc-curated' or 'readme-doi-evidence'."@en .
:openIssuesCount rdfs:label "open issues count"@en ; rdfs:comment "Open issues and pull requests count as reported by GitHub ('open_issues_count')."@en .
:originalRepositoryUrl rdfs:label "original repository URL"@en ; rdfs:comment "The URL as originally recorded in the source dataset."@en .
:profileUrl rdfs:label "profile URL"@en ; rdfs:comment "Web URL of the account profile."@en .
:starsCount rdfs:label "stars count"@en ; rdfs:comment "Number of stargazers at snapshot time."@en .
:targetKnowledgeGraph rdfs:label "target knowledge graph"@en ; rdfs:comment "Name of the external knowledge graph, e.g. 'SemOpenAlex', 'LPWC', 'MLSea-KG'."@en .

:ApiError rdfs:label "API error"@en ; rdfs:comment "Resolution failed because of an unexpected API error; the URL stays retryable."@en .
:Deleted rdfs:label "Deleted"@en ; rdfs:comment "The repository no longer exists."@en .
:Invalid rdfs:label "Invalid"@en ; rdfs:comment "The URL is not a valid repository URL."@en .
:Private rdfs:label "Private"@en ; rdfs:comment "The repository is private or inaccessible."@en .
:Renamed rdfs:label "Renamed"@en ; rdfs:comment "The repository was renamed under the same owner."@en .
:Resolved rdfs:label "Resolved"@en ; rdfs:comment "The URL resolves directly to a repository."@en .
:Transferred rdfs:label "Transferred"@en ; rdfs:comment "The repository moved to a different owner."@en .
:Success rdfs:label "Success"@en ; rdfs:comment "Collection completed fully."@en .
:Failed rdfs:label "Failed"@en ; rdfs:comment "Collection failed."@en .
:NotFound rdfs:label "Not found"@en ; rdfs:comment "The target was not found (HTTP 404)."@en .
:Forbidden rdfs:label "Forbidden"@en ; rdfs:comment "Access was denied (HTTP 403, not rate limiting)."@en .
:RateLimited rdfs:label "Rate limited"@en ; rdfs:comment "Collection stopped by API rate limiting."@en .
:PartialSuccess rdfs:label "Partial success"@en ; rdfs:comment "Core data collected, some parts missing."@en .
