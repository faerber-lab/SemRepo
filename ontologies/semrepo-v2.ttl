@prefix : <https://semrepo.org/ontology/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://semrepo.org/ontology/v2#> .

<https://semrepo.org/ontology/v2#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://semrepo.org/ontology/v2#hasExternalLink
:hasExternalLink rdf:type owl:ObjectProperty ;
                 owl:inverseOf :linkSource ;
                 rdfs:range :ExternalLink .


###  https://semrepo.org/ontology/v2#hasSnapshot
:hasSnapshot rdf:type owl:ObjectProperty ;
             owl:inverseOf :snapshotOf ;
             rdfs:domain :Repository ;
             rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#linkSource
:linkSource rdf:type owl:ObjectProperty ;
            rdfs:range :ExternalLink .


###  https://semrepo.org/ontology/v2#resolutionStatus
:resolutionStatus rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range :ResolutionStatus .


###  https://semrepo.org/ontology/v2#resolvedRepository
:resolvedRepository rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :SourceRepositoryLink ;
                    rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#snapshotOf
:snapshotOf rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range :Repository .


#################################################################
#    Data properties
#################################################################

###  https://semrepo.org/ontology/v2#archived
:archived rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :RepositorySnapshot ;
          rdfs:range xsd:boolean .


###  https://semrepo.org/ontology/v2#canonicalUrl
:canonicalUrl rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Repository ;
              rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#collectedAt
:collectedAt rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#confidenceScore
:confidenceScore rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ExternalLink ;
                 rdfs:range xsd:decimal .


###  https://semrepo.org/ontology/v2#createdAt
:createdAt rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Repository ;
           rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#description
:description rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#finalResolvedUrl
:finalResolvedUrl rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#forksCount
:forksCount rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#githubLogin
:githubLogin rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :GitHubAccount ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#githubRepositoryId
:githubRepositoryId rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Repository ;
                    rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubUserId
:githubUserId rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :GitHubAccount ;
              rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#linkDecision
:linkDecision rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ExternalLink ;
              rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkRelationType
:linkRelationType rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :ExternalLink ;
                  rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkTarget
:linkTarget rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :ExternalLink ;
            rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#linkingMethod
:linkingMethod rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ExternalLink ;
               rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#openIssuesCount
:openIssuesCount rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :RepositorySnapshot ;
                 rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#originalRepositoryUrl
:originalRepositoryUrl rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :SourceRepositoryLink ;
                       rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#profileUrl
:profileUrl rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :GitHubAccount ;
            rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#starsCount
:starsCount rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#targetKnowledgeGraph
:targetKnowledgeGraph rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :ExternalLink ;
                      rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://semrepo.org/ontology/v2#ExternalLink
:ExternalLink rdf:type owl:Class ;
              rdfs:comment "A qualified, evidence-based link from a SemRepo entity to an entity in an external knowledge graph (e.g. SemOpenAlex, LPWC, MLSea-KG), carrying provenance and confidence information rather than asserting direct identity."@en ;
              rdfs:label "External Link"@en .


###  https://semrepo.org/ontology/v2#GitHubAccount
:GitHubAccount rdf:type owl:Class ;
               rdfs:comment "A GitHub account, which may represent a human user, an organisation, or a bot. Not necessarily a natural person."@en ;
               rdfs:label "GitHub Account"@en .


###  https://semrepo.org/ontology/v2#GitHubBot
:GitHubBot rdf:type owl:Class ;
           rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubOrganisation
:GitHubOrganisation rdf:type owl:Class ;
                    rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubUser
:GitHubUser rdf:type owl:Class ;
            rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#Repository
:Repository rdf:type owl:Class ;
            rdfs:comment "A GitHub repository, identified by its stable numeric GitHub ID. Represents only identity-level information; mutable metadata is captured in RepositorySnapshot instances."@en ;
            rdfs:label "Repository"@en .


###  https://semrepo.org/ontology/v2#RepositorySnapshot
:RepositorySnapshot rdf:type owl:Class ;
                    rdfs:comment "A dated observation of a Repository's mutable metadata (stars, forks, issues, description, etc.) at a specific collection time."@en ;
                    rdfs:label "Repository Snapshot"@en .


###  https://semrepo.org/ontology/v2#ResolutionStatus
:ResolutionStatus rdf:type owl:Class ;
                  rdfs:comment "A controlled set of possible outcomes for resolving a source repository URL to a canonical Repository."@en ;
                  rdfs:label "Resolution Status"@en .


###  https://semrepo.org/ontology/v2#SourceRepositoryLink
:SourceRepositoryLink rdf:type owl:Class ;
                      rdfs:comment "Represents the resolution process from an originally recorded LPWC repository URL to a canonical Repository, tracking redirects, renames, or failures."@en ;
                      rdfs:label "Source Repository Link"@en .


#################################################################
#    Individuals
#################################################################

###  https://semrepo.org/ontology/v2#ApiError
:ApiError rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Deleted
:Deleted rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Invalid
:Invalid rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Private
:Private rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Renamed
:Renamed rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Resolved
:Resolved rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Transferred
:Transferred rdf:type owl:NamedIndividual ,
                      :ResolutionStatus .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :GitHubBot
                :GitHubOrganisation
                :GitHubUser
              )
] .


