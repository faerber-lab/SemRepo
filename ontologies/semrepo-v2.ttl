@prefix : <https://semrepo.org/ontology/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://semrepo.org/ontology/v2#> .

<https://semrepo.org/ontology/v2#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://semrepo.org/ontology/v2#belongsToRepository
:belongsToRepository rdf:type owl:ObjectProperty ;
                     owl:inverseOf :hasIssue ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :Issue ;
                     rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#collectionStatus
:collectionStatus rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CollectionActivity ;
                  rdfs:range :CollectionStatus .


###  https://semrepo.org/ontology/v2#contributionToSnapshot
:contributionToSnapshot rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Contribution ;
                        rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#contributor
:contributor rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Contribution ;
             rdfs:range :GitHubAccount .


###  https://semrepo.org/ontology/v2#hasExternalLink
:hasExternalLink rdf:type owl:ObjectProperty ;
                 owl:inverseOf :linkSource ;
                 rdfs:range :ExternalLink .


###  https://semrepo.org/ontology/v2#hasIssue
:hasIssue rdf:type owl:ObjectProperty ;
          rdfs:domain :Repository ;
          rdfs:range :Issue .


###  https://semrepo.org/ontology/v2#hasSnapshot
:hasSnapshot rdf:type owl:ObjectProperty ;
             owl:inverseOf :snapshotOf ;
             rdfs:domain :Repository ;
             rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#languageUsageIn
:languageUsageIn rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :LanguageUsage ;
                 rdfs:range :RepositorySnapshot .


###  https://semrepo.org/ontology/v2#linkSource
:linkSource rdf:type owl:ObjectProperty ;
            rdfs:domain :ExternalLink .


###  https://semrepo.org/ontology/v2#programmingLanguage
:programmingLanguage rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :LanguageUsage ;
                     rdfs:range :ProgrammingLanguage .


###  https://semrepo.org/ontology/v2#resolutionStatus
:resolutionStatus rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range :ResolutionStatus .


###  https://semrepo.org/ontology/v2#resolvedRepository
:resolvedRepository rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :SourceRepositoryLink ;
                    rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#resultedInRepository
:resultedInRepository rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :CollectionActivity ;
                      rdfs:range :Repository .


###  https://semrepo.org/ontology/v2#snapshotOf
:snapshotOf rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range :Repository .


#################################################################
#    Data properties
#################################################################

###  https://semrepo.org/ontology/v2#archived
:archived rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :RepositorySnapshot ;
          rdfs:range xsd:boolean .


###  https://semrepo.org/ontology/v2#attemptedUrl
:attemptedUrl rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :CollectionActivity ;
              rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#canonicalUrl
:canonicalUrl rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Repository ;
              rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#collectedAt
:collectedAt rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#collectionSource
:collectionSource rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CollectionActivity ;
                  rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#collectionTimestamp
:collectionTimestamp rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :CollectionActivity ;
                     rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#commitCount
:commitCount rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Contribution ;
             rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#confidenceScore
:confidenceScore rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ExternalLink ;
                 rdfs:range xsd:decimal .


###  https://semrepo.org/ontology/v2#createdAt
:createdAt rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Repository ;
           rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#description
:description rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RepositorySnapshot ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#finalResolvedUrl
:finalResolvedUrl rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SourceRepositoryLink ;
                  rdfs:range xsd:anyURI .


###  https://semrepo.org/ontology/v2#forksCount
:forksCount rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :RepositorySnapshot ;
            rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#githubIssueId
:githubIssueId rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Issue ;
               rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubLogin
:githubLogin rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :GitHubAccount ;
             rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#githubRepositoryId
:githubRepositoryId rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Repository ;
                    rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#githubUserId
:githubUserId rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :GitHubAccount ;
              rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#issueClosedAt
:issueClosedAt rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Issue ;
               rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#issueCreatedAt
:issueCreatedAt rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Issue ;
                rdfs:range xsd:dateTime .


###  https://semrepo.org/ontology/v2#issueNumber
:issueNumber rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Issue ;
             rdfs:range xsd:integer .


###  https://semrepo.org/ontology/v2#issueState
:issueState rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Issue ;
            rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#languageBytes
:languageBytes rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :LanguageUsage ;
               rdfs:range xsd:nonNegativeInteger .


###  https://semrepo.org/ontology/v2#languageName
:languageName rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ProgrammingLanguage ;
              rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkDecision
:linkDecision rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ExternalLink ;
              rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkRelationType
:linkRelationType rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :ExternalLink ;
                  rdfs:range xsd:string .


###  https://semrepo.org/ontology/v2#linkTarget
:linkTarget rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :ExternalLink ;
            rdfs:range xsd:anyURI .


