#################################################################
#    Classes
#################################################################

###  https://semrepo.org/ontology/v2#CollectionActivity
:CollectionActivity rdf:type owl:Class ;
                    rdfs:comment "A single attempt by the data collection pipeline to fetch or resolve data for a target URL, whether or not it succeeded. Supports provenance and completeness tracking."@en ;
                    rdfs:label "Collection Activity"@en .


###  https://semrepo.org/ontology/v2#CollectionStatus
:CollectionStatus rdf:type owl:Class ;
                  rdfs:comment "A controlled set of possible outcomes for a single collection attempt, distinct from ResolutionStatus which tracks LPWC URL-to-Repository resolution specifically."@en ;
                  rdfs:label "Collection Status"@en .


###  https://semrepo.org/ontology/v2#Contribution
:Contribution rdf:type owl:Class ;
              rdfs:comment "Represents a GitHub account's commit contribution to a specific repository snapshot, replacing v1's duplicated ContributorReference/hasContributorReference classes."@en ;
              rdfs:label "Contribution"@en .


###  https://semrepo.org/ontology/v2#ExternalLink
:ExternalLink rdf:type owl:Class ;
              rdfs:comment "A qualified, evidence-based link from a SemRepo entity to an entity in an external knowledge graph (e.g. SemOpenAlex, LPWC, MLSea-KG), carrying provenance and confidence information rather than asserting direct identity."@en ;
              rdfs:label "External Link"@en .


###  https://semrepo.org/ontology/v2#GitHubAccount
:GitHubAccount rdf:type owl:Class ;
               rdfs:comment "A GitHub account, which may represent a human user, an organisation, or a bot. Not necessarily a natural person."@en ;
               rdfs:label "GitHub Account"@en .


###  https://semrepo.org/ontology/v2#GitHubBot
:GitHubBot rdf:type owl:Class ;
           rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubOrganisation
:GitHubOrganisation rdf:type owl:Class ;
                    rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#GitHubUser
:GitHubUser rdf:type owl:Class ;
            rdfs:subClassOf :GitHubAccount .


###  https://semrepo.org/ontology/v2#Issue
:Issue rdf:type owl:Class ;
       rdfs:comment "A GitHub issue belonging to a repository. GitHub's issues API also returns pull requests; this class represents issues that are not pull requests. See PullRequest for the PR-specific subtype."@en ;
       rdfs:label "Issue"@en .


###  https://semrepo.org/ontology/v2#LanguageUsage
:LanguageUsage rdf:type owl:Class ;
               rdfs:comment "Represents the usage of a programming language within a specific repository snapshot, replacing v1's duplicated LanguageReference/GitHubRepositoryLanguageReference classes."@en ;
               rdfs:label "Language Usage"@en .


###  https://semrepo.org/ontology/v2#ProgrammingLanguage
:ProgrammingLanguage rdf:type owl:Class ;
                     rdfs:comment "A programming language (e.g. Python, C++), identified by name."@en ;
                     rdfs:label "Programming Language"@en .


###  https://semrepo.org/ontology/v2#PullRequest
:PullRequest rdf:type owl:Class ;
             rdfs:subClassOf :Issue ;
             rdfs:comment "A GitHub pull request. Modeled as a subclass of Issue since PRs share most Issue fields but add PR-specific semantics."@en ;
             rdfs:label "Pull Request"@en .


###  https://semrepo.org/ontology/v2#Repository
:Repository rdf:type owl:Class ;
            rdfs:comment "A GitHub repository, identified by its stable numeric GitHub ID. Represents only identity-level information; mutable metadata is captured in RepositorySnapshot instances."@en ;
            rdfs:label "Repository"@en .


###  https://semrepo.org/ontology/v2#RepositorySnapshot
:RepositorySnapshot rdf:type owl:Class ;
                    rdfs:comment "A dated observation of a Repository's mutable metadata (stars, forks, issues, description, etc.) at a specific collection time."@en ;
                    rdfs:label "Repository Snapshot"@en .


###  https://semrepo.org/ontology/v2#ResolutionStatus
:ResolutionStatus rdf:type owl:Class ;
                  rdfs:comment "A controlled set of possible outcomes for resolving a source repository URL to a canonical Repository."@en ;
                  rdfs:label "Resolution Status"@en .


###  https://semrepo.org/ontology/v2#SourceRepositoryLink
:SourceRepositoryLink rdf:type owl:Class ;
                      rdfs:comment "Represents the resolution process from an originally recorded LPWC repository URL to a canonical Repository, tracking redirects, renames, or failures."@en ;
                      rdfs:label "Source Repository Link"@en .


#################################################################
#    Individuals
#################################################################

###  https://semrepo.org/ontology/v2#ApiError
:ApiError rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Deleted
:Deleted rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Failed
:Failed rdf:type owl:NamedIndividual ,
                 :CollectionStatus .


###  https://semrepo.org/ontology/v2#Forbidden
:Forbidden rdf:type owl:NamedIndividual ,
                    :CollectionStatus .


###  https://semrepo.org/ontology/v2#Invalid
:Invalid rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#NotFound
:NotFound rdf:type owl:NamedIndividual ,
                   :CollectionStatus .


###  https://semrepo.org/ontology/v2#PartialSuccess
:PartialSuccess rdf:type owl:NamedIndividual ,
                         :CollectionStatus .


###  https://semrepo.org/ontology/v2#Private
:Private rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#RateLimited
:RateLimited rdf:type owl:NamedIndividual ,
                      :CollectionStatus .


###  https://semrepo.org/ontology/v2#Renamed
:Renamed rdf:type owl:NamedIndividual ,
                  :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Resolved
:Resolved rdf:type owl:NamedIndividual ,
                   :ResolutionStatus .


###  https://semrepo.org/ontology/v2#Success
:Success rdf:type owl:NamedIndividual ,
                  :CollectionStatus .


###  https://semrepo.org/ontology/v2#Transferred
:Transferred rdf:type owl:NamedIndividual ,
                      :ResolutionStatus .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :GitHubBot
                :GitHubOrganisation
                :GitHubUser
              )
] .


