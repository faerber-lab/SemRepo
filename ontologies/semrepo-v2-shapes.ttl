@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <https://semrepo.org/ontology/v2#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    GitHubAccount pattern
#################################################################

:GitHubAccountCoreShape
    a sh:NodeShape ;
    sh:property [
        sh:path :githubUserId ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :githubLogin ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :profileUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :accountName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :accountDescription ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :accountLocation ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :accountBlogUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :accountCreatedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :followersCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :publicReposCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] .

:GitHubUserShape
    a sh:NodeShape ;
    sh:targetClass :GitHubUser ;
    sh:node :GitHubAccountCoreShape .

:GitHubOrganisationShape
    a sh:NodeShape ;
    sh:targetClass :GitHubOrganisation ;
    sh:node :GitHubAccountCoreShape .

:GitHubBotShape
    a sh:NodeShape ;
    sh:targetClass :GitHubBot ;
    sh:node :GitHubAccountCoreShape .

#################################################################
#    Repository / RepositorySnapshot pattern
#################################################################

:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass :Repository ;
    sh:property [
        sh:path :githubRepositoryId ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :canonicalUrl ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :createdAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :hasSnapshot ;
        sh:class :RepositorySnapshot ;
    ] .

:RepositorySnapshotShape
    a sh:NodeShape ;
    sh:targetClass :RepositorySnapshot ;
    sh:property [
        sh:path :collectedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :starsCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :forksCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :openIssuesCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :archived ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :snapshotOf ;
        sh:class :Repository ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :repositoryName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :fullName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :defaultBranch ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :homepageUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :isFork ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :pushedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :updatedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :lastCommitAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :watchersCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :contributorsCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issuesTotalCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :sizeKb ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :hasLicense ;
        sh:class :License ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :hasTopic ;
        sh:class :Topic ;
    ] ;
    sh:property [
        sh:path :primaryLanguage ;
        sh:class :ProgrammingLanguage ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :ownerAccount ;
        sh:or ( [ sh:class :GitHubUser ] [ sh:class :GitHubOrganisation ] [ sh:class :GitHubBot ] ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :snapshotCollectedBy ;
        sh:class :CollectionActivity ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    ExternalLink pattern
#################################################################

:ExternalLinkShape
    a sh:NodeShape ;
    sh:targetClass :ExternalLink ;
    sh:property [
        sh:path :linkTarget ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :targetKnowledgeGraph ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkRelationType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkingMethod ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :confidenceScore ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkDecision ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class :Repository ]
            [ sh:class :GitHubUser ]
            [ sh:class :GitHubOrganisation ]
            [ sh:class :GitHubBot ]
        ) ;
    ] .

#################################################################
#    SourceRepositoryLink / ResolutionStatus pattern
#################################################################

:SourceRepositoryLinkShape
    a sh:NodeShape ;
    sh:targetClass :SourceRepositoryLink ;
    sh:property [
        sh:path :originalRepositoryUrl ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :finalResolvedUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :resolutionStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( :Resolved :Renamed :Transferred :Deleted :Private :Invalid :ApiError ) ;
    ] ;
    sh:property [
        sh:path :resolvedRepository ;
        sh:class :Repository ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    CollectionActivity / CollectionStatus pattern
#################################################################

:CollectionActivityShape
    a sh:NodeShape ;
    sh:targetClass :CollectionActivity ;
    sh:property [
        sh:path :collectionTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :attemptedUrl ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :collectionSource ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :collectionStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( :Success :Failed :NotFound :RateLimited :Forbidden :PartialSuccess ) ;
    ] ;
    sh:property [
        sh:path :resultedInRepository ;
        sh:class :Repository ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    Contribution pattern
#################################################################

:ContributionShape
    a sh:NodeShape ;
    sh:targetClass :Contribution ;
    sh:property [
        sh:path :contributionToSnapshot ;
        sh:class :RepositorySnapshot ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :contributor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class :GitHubUser ]
            [ sh:class :GitHubOrganisation ]
            [ sh:class :GitHubBot ]
        ) ;
    ] ;
    sh:property [
        sh:path :commitCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    LanguageUsage / ProgrammingLanguage pattern
#################################################################

:LanguageUsageShape
    a sh:NodeShape ;
    sh:targetClass :LanguageUsage ;
    sh:property [
        sh:path :languageUsageIn ;
        sh:class :RepositorySnapshot ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :programmingLanguage ;
        sh:class :ProgrammingLanguage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :languageBytes ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:ProgrammingLanguageShape
    a sh:NodeShape ;
    sh:targetClass :ProgrammingLanguage ;
    sh:property [
        sh:path :languageName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    Issue / PullRequest pattern
#################################################################

:IssueCoreShape
    a sh:NodeShape ;
    sh:property [
        sh:path :githubIssueId ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueState ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueCreatedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueClosedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :belongsToRepository ;
        sh:class :Repository ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueTitle ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueUpdatedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueCommentCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :issueLabel ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path :issueAuthor ;
        sh:or ( [ sh:class :GitHubUser ] [ sh:class :GitHubOrganisation ] [ sh:class :GitHubBot ] ) ;
        sh:maxCount 1 ;
    ] .

:IssueShape
    a sh:NodeShape ;
    sh:targetClass :Issue ;
    sh:node :IssueCoreShape .

:PullRequestShape
    a sh:NodeShape ;
    sh:targetClass :PullRequest ;
    sh:node :IssueCoreShape ;
    sh:property [
        sh:path :pullRequestMergedAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    License / Topic (v2.1)
#################################################################

:LicenseShape
    a sh:NodeShape ;
    sh:targetClass :License ;
    sh:property [ sh:path :spdxId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :licenseName ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:TopicShape
    a sh:NodeShape ;
    sh:targetClass :Topic ;
    sh:property [ sh:path :topicName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
