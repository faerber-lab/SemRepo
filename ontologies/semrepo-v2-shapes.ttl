@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <https://semrepo.org/ontology/v2#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    GitHubAccount pattern
#################################################################

:GitHubAccountCoreShape
    a sh:NodeShape ;
    sh:property [
        sh:path :githubUserId ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :githubLogin ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :profileUrl ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] .

:GitHubUserShape
    a sh:NodeShape ;
    sh:targetClass :GitHubUser ;
    sh:node :GitHubAccountCoreShape .

:GitHubOrganisationShape
    a sh:NodeShape ;
    sh:targetClass :GitHubOrganisation ;
    sh:node :GitHubAccountCoreShape .

:GitHubBotShape
    a sh:NodeShape ;
    sh:targetClass :GitHubBot ;
    sh:node :GitHubAccountCoreShape .

#################################################################
#    Repository / RepositorySnapshot pattern
#################################################################

:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass :Repository ;
    sh:property [
        sh:path :githubRepositoryId ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :canonicalUrl ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :createdAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :hasSnapshot ;
        sh:class :RepositorySnapshot ;
    ] .

:RepositorySnapshotShape
    a sh:NodeShape ;
    sh:targetClass :RepositorySnapshot ;
    sh:property [
        sh:path :collectedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :starsCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :forksCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :openIssuesCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :archived ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :snapshotOf ;
        sh:class :Repository ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    ExternalLink pattern
#################################################################

:ExternalLinkShape
    a sh:NodeShape ;
    sh:targetClass :ExternalLink ;
    sh:property [
        sh:path :linkTarget ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :targetKnowledgeGraph ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkRelationType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkingMethod ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :confidenceScore ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkDecision ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :linkSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class :Repository ]
            [ sh:class :GitHubUser ]
            [ sh:class :GitHubOrganisation ]
            [ sh:class :GitHubBot ]
        ) ;
    ] .