PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-18: Which contributors have the highest recorded commit counts?
SELECT ?account ?login (SUM(?commits) AS ?totalCommits) WHERE {
  ?contribution :contributor ?account ; :commitCount ?commits .
  OPTIONAL { ?account :githubLogin ?login }
} GROUP BY ?account ?login ORDER BY DESC(?totalCommits)
