PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-49: Which repositories have experienced ownership transfers, and what were the previous and new owners with transfer dates?
SELECT ?repository ?snapshot ?owner ?login ?collectedAt WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :ownerAccount ?owner .
  OPTIONAL { ?owner :githubLogin ?login }
  OPTIONAL { ?snapshot :collectedAt ?collectedAt }
} ORDER BY ?repository ?collectedAt
