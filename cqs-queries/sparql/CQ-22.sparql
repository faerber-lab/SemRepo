PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-22: Which repositories have a detected software license, and what SPDX identifier does it have?
SELECT ?repository ?snapshot ?spdxId ?licenseName WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :hasLicense ?license .
  OPTIONAL { ?license :spdxId ?spdxId }
  OPTIONAL { ?license :licenseName ?licenseName }
}
