PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-48: Which repositories depend on or import other repositories, and what dependency versions are used?
SELECT ?repository ?url ?description WHERE {
  ?repository :hasSnapshot ?snapshot .
  OPTIONAL { ?snapshot :homepageUrl ?url }
  OPTIONAL { ?snapshot :description ?description }
}
