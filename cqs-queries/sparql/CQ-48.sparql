PREFIX sr: <https://semrepo.org/ontology/v2#>

## "How are repositories used in scholarly publications (e.g., introduced, evaluated, used, or described)?
SELECT DISTINCT
    ?repository
    ?repositoryId
    ?repositoryURL
    ?linkTarget
    ?relationship
WHERE {
    ?externalLink a sr:ExternalLink ;
        sr:linkSource ?repository ;
        sr:linkTarget ?linkTarget ;
        sr:linkRelationType ?relationship .

    FILTER(STR(?relationship) != "same software as")
    FILTER(STR(?relationship) != "same repository as")

    OPTIONAL {
        ?repository sr:githubRepositoryId ?repositoryId .
    }

    OPTIONAL {
        ?repository sr:canonicalUrl ?repositoryURL .
    }
}
LIMIT 20
