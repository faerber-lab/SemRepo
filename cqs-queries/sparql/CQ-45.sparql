PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-45: Which repositories have received code contributions from each contributor over time, including per-contribution timestamps?
SELECT ?account ?repository ?snapshotTime ?commitCount WHERE {
  ?contribution :contributor ?account ;
    :contributionToSnapshot ?snapshot .
  ?snapshot :snapshotOf ?repository .
  OPTIONAL { ?snapshot :collectedAt ?snapshotTime }
  OPTIONAL { ?contribution :commitCount ?commitCount }
}
