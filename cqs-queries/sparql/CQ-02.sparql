PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-02: Which repository snapshots belong to each repository, and when were they collected?
SELECT ?repository ?snapshot ?collectedAt WHERE {
  ?repository a :Repository ; :hasSnapshot ?snapshot .
  OPTIONAL { ?snapshot :collectedAt ?collectedAt }
} ORDER BY ?repository DESC(?collectedAt)
