PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-34: What relation type and linking method were recorded for each external link?
SELECT ?link ?relation ?method ?knowledgeGraph ?target WHERE {
  ?link a :ExternalLink .
  OPTIONAL { ?link :linkRelationType ?relation }
  OPTIONAL { ?link :linkingMethod ?method }
  OPTIONAL { ?link :targetKnowledgeGraph ?knowledgeGraph }
  OPTIONAL { ?link :linkTarget ?target }
}
