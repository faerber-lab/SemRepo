PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-51: What is the citation impact of papers associated with repositories, including citation counts and citing publications?
SELECT ?repository ?target ?knowledgeGraph WHERE {
  ?repository :hasExternalLink ?link .
  OPTIONAL { ?link :linkTarget ?target }
  OPTIONAL { ?link :targetKnowledgeGraph ?knowledgeGraph }
}
