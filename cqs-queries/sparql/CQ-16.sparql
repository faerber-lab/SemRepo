PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-16: Which GitHub accounts have the largest number of public repositories?
SELECT ?account ?login ?repoCount WHERE {
  ?account a :GitHubAccount ; :publicReposCount ?repoCount .
  OPTIONAL { ?account :githubLogin ?login }
} ORDER BY DESC(?repoCount)
