PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-47: Which issues and pull requests were assigned to each GitHub account?
SELECT ?issue ?title ?author WHERE {
  ?issue a :Issue .
  OPTIONAL { ?issue :issueTitle ?title }
  OPTIONAL { ?issue :issueAuthor ?author }
}
