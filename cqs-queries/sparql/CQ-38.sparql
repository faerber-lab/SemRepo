PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-38: Which collection activities were attempted, and what URL and source were used?
SELECT ?activity ?url ?source ?timestamp WHERE {
  ?activity a :CollectionActivity .
  OPTIONAL { ?activity :attemptedUrl ?url }
  OPTIONAL { ?activity :collectionSource ?source }
  OPTIONAL { ?activity :collectionTimestamp ?timestamp }
} ORDER BY DESC(?timestamp)
