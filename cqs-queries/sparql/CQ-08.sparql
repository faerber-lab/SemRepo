PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-08: Which repositories have the highest number of open issues and pull requests?
SELECT ?repository ?snapshot ?openIssuesCount WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :openIssuesCount ?openIssuesCount .
} ORDER BY DESC(?openIssuesCount)
