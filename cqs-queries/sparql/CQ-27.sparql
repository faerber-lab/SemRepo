PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-27: Which issues and pull requests are currently recorded as open?
SELECT ?issue ?number ?title ?state WHERE {
  ?issue a :Issue ; :issueState ?state .
  FILTER (LCASE(STR(?state)) = "open")
  OPTIONAL { ?issue :issueNumber ?number }
  OPTIONAL { ?issue :issueTitle ?title }
}
