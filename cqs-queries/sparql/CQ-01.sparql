PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-01: Which repositories are recorded in SemRepo, together with their stable GitHub identifiers and canonical URLs?
SELECT ?repository ?githubRepositoryId ?canonicalUrl WHERE {
  ?repository a :Repository .
  OPTIONAL { ?repository :githubRepositoryId ?githubRepositoryId }
  OPTIONAL { ?repository :canonicalUrl ?canonicalUrl }
} ORDER BY ?githubRepositoryId
