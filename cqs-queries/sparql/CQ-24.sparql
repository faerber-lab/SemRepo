PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-24: Which topics are assigned to each repository snapshot?
SELECT ?repository ?snapshot ?topic ?topicName WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :hasTopic ?topic .
  OPTIONAL { ?topic :topicName ?topicName }
} ORDER BY ?repository ?topicName
