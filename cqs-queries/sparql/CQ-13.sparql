PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-13: Which GitHub accounts own repositories in each snapshot?
SELECT ?snapshot ?account ?login ?accountType WHERE {
  ?snapshot :ownerAccount ?account .
  OPTIONAL { ?account :githubLogin ?login }
  OPTIONAL { ?account a ?accountType .
    FILTER (?accountType IN (:GitHubUser,:GitHubOrganisation,:GitHubBot)) }
}
