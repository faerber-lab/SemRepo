PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-11: How do star counts for a repository change across its collected snapshots?
SELECT ?repository ?snapshot ?collectedAt ?starsCount WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :collectedAt ?collectedAt ; :starsCount ?starsCount .
} ORDER BY ?repository ?collectedAt
