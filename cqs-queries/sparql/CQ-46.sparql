PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-46: Which pull requests were reviewed, who reviewed them, and what review decisions were made?
SELECT ?pullRequest ?mergedAt WHERE {
  ?pullRequest a :PullRequest .
  OPTIONAL { ?pullRequest :pullRequestMergedAt ?mergedAt }
}
