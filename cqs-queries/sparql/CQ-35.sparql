PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-35: Which external links have confidence scores above/under a selected threshold?
SELECT ?link ?score ?target WHERE {
  ?link a :ExternalLink ; :confidenceScore ?score .
  OPTIONAL { ?link :linkTarget ?target }
  FILTER (?score <= 0.7)
} ORDER BY DESC(?score)
LIMIT 20

---

PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-35: Which external links have confidence scores above a selected threshold?
SELECT ?link ?score ?target WHERE {
  ?link a :ExternalLink ; :confidenceScore ?score .
  OPTIONAL { ?link :linkTarget ?target }
  FILTER (?score >= 0.8)
} ORDER BY DESC(?score)
