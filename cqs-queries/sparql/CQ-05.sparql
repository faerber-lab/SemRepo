PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-05: Which repositories are archived, and what was their archived status at snapshot time?
SELECT ?repository ?snapshot ?archived ?collectedAt WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :archived ?archived .
  OPTIONAL { ?snapshot :collectedAt ?collectedAt }
} ORDER BY ?repository DESC(?collectedAt)
