PREFIX sr: <https://semrepo.org/ontology/v2#>
PREFIX dcterms: <http://purl.org/dc/terms/>

## What is the citation impact of papers associated with repositories, including citation counts?
SELECT DISTINCT
    ?repositoryId
    ?repositoryURL
    ?publicationIdentifier
    ?publicationTitle
    ?linkRelationType
    ?targetKnowledgeGraph
WHERE {
    ?repository a sr:Repository ;
        sr:githubRepositoryId ?repositoryId ;
        sr:canonicalUrl ?repositoryURL ;
        sr:hasExternalLink ?externalLink .

    ?externalLink a sr:ExternalLink ;
        sr:linkSource ?repository ;
        sr:linkTarget ?publicationIdentifier ;
        sr:linkRelationType ?linkRelationType ;
        sr:targetKnowledgeGraph ?targetKnowledgeGraph .

    BIND(IRI(STR(?publicationIdentifier)) AS ?publication)

    ?publication dcterms:title ?publicationTitle .
}
LIMIT 20
