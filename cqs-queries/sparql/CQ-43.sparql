PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-43: Which repositories are the official implementations of scientific papers, and what paper titles and DOIs identify those papers?
SELECT ?repository ?relation ?target WHERE {
  ?repository :hasExternalLink ?link .
  OPTIONAL { ?link :linkRelationType ?relation }
  OPTIONAL { ?link :linkTarget ?target }
  FILTER (CONTAINS(LCASE(STR(?relation)), "official"))
}
