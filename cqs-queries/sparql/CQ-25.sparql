PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-25: Which topics are most frequently assigned across repository snapshots?
SELECT ?topicName (COUNT(DISTINCT ?snapshot) AS ?snapshotCount) WHERE {
  ?snapshot :hasTopic ?topic .
  ?topic :topicName ?topicName .
} GROUP BY ?topicName ORDER BY DESC(?snapshotCount)
