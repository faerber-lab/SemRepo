PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-40: Which successful collection activities resulted in a repository?
SELECT ?activity ?repository ?timestamp WHERE {
  ?activity :collectionStatus :Success ;
    :resultedInRepository ?repository .
  OPTIONAL { ?activity :collectionTimestamp ?timestamp }
}
