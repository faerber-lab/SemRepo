PREFIX : <https://semrepo.org/ontology/v2#>

# CQ-12: Which repositories are forks, and what are their recorded sizes?
SELECT ?repository ?snapshot ?isFork ?sizeKb
WHERE {
    ?repository :hasSnapshot ?snapshot .
    ?snapshot :isFork ?isFork .

    FILTER(?isFork = true)

    OPTIONAL {
        ?snapshot :sizeKb ?sizeKb .
    }
}
LIMIT 20

---
PREFIX : <https://semrepo.org/ontology/v2#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-12: Which repositories are forks, and what are their recorded sizes?
SELECT ?repository ?snapshot ?isFork ?sizeKb WHERE {
  ?repository :hasSnapshot ?snapshot .
  ?snapshot :isFork ?isFork .
  OPTIONAL { ?snapshot :sizeKb ?sizeKb }
}
